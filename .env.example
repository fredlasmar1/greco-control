# ─── Trinks API ───────────────────────────────────────
# Sua chave da API Trinks (obrigatório)
TRINKS_API_KEY=sua_chave_aqui

# ID do estabelecimento no Trinks (obrigatório)
TRINKS_ESTABLISHMENT_ID=238676

# ─── IA (Análise Financeira) ──────────────────────────
# Chave da API Anthropic para análise com IA (opcional)
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# ─── Telegram Bot (@fredgreco_bot) ────────────────────
# Token do bot (criado no @BotFather). Se preenchido, habilita
# envio automático de resumos às 8h (manhã) e 20h (noite).
TELEGRAM_BOT_TOKEN=

# Chat ID para quem mandar as mensagens (default: do dono)
TELEGRAM_CHAT_ID=5565354217

# ─── Servidor ─────────────────────────────────────────
# Porta do servidor (Railway define automaticamente)
PORT=5000
NODE_ENV=production
